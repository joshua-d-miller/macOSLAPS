<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOSLAPS 4.0 example settings. Deliver as a configuration profile with
  PayloadType com.joshua-d-miller.macoslaps (edu.psu.macoslaps still works in 4.x).
  Every key is optional. The values below are examples, not the built-in
  defaults; "Profile Manifests/" in the repository lists every key with its
  default.
  Run "sudo macOSLAPS -showConfig" to see what a Mac actually uses.
-->
<plist version="1.0">
<dict>
	<!-- Account and method -->
	<key>LocalAdminAccount</key>
	<string>admin</string>
	<key>Method</key>
	<string>Local</string>            <!-- Local or AD -->
	<key>DaysTillExpiration</key>
	<integer>60</integer>
	<key>FirstPass</key>
	<string></string>                 <!-- current password of a secureToken account, for the first rotation -->

	<!-- Active Directory (Method AD) -->
	<key>ADSchema</key>
	<string>legacy</string>           <!-- legacy, windowsLAPS or both -->
	<key>PreferredDC</key>
	<string></string>

	<!-- Password -->
	<key>PasswordStyle</key>
	<string>random</string>           <!-- random or readable (letters/digits, no look-alikes, grouped by 4) -->
	<key>PasswordLength</key>
	<integer>16</integer>             <!-- generated characters; separators are extra -->
	<key>PasswordGrouping</key>
	<integer>0</integer>
	<key>PasswordSeparator</key>
	<string>-</string>
	<key>RemovePassChars</key>
	<string>'"`</string>
	<key>ExclusionSets</key>
	<array/>                          <!-- symbols, letters, numbers -->
	<key>PasswordRequirements</key>
	<dict>
		<key>Lowercase</key>
		<integer>1</integer>
		<key>Uppercase</key>
		<integer>1</integer>
		<key>Number</key>
		<integer>1</integer>
		<key>Symbol</key>
		<integer>1</integer>
	</dict>
	<key>RemoveKeychain</key>
	<true/>

	<!-- Escrow (macOSLAPS -escrow). Add RSA certificates to encrypt for your admins. -->
	<key>EscrowCertificates</key>
	<array>
		<!-- One <string> per certificate: the PEM text (BEGIN CERTIFICATE ... END CERTIFICATE) or base64 DER -->
	</array>

	<!-- Staged rotation: the MDM collects the next password (via -escrow) before it is used -->
	<key>StagedRotation</key>
	<string>auto</string>             <!-- auto (when -escrow runs on this Mac), on or off -->
	<key>EscrowConfirmations</key>
	<integer>2</integer>              <!-- -escrow exports needed before a staged password is applied -->

	<!-- Refresh MDM inventory after a rotation -->
	<key>InventoryHook</key>
	<string></string>                 <!-- jamf or custom -->
	<key>InventoryHookCommand</key>
	<array/>                          <!-- e.g. /usr/local/bin/some-agent, refresh -->
	<key>InventoryHookConfirms</key>
	<false/>                          <!-- custom hook: true if it collects inventory (confirms staged passwords) -->

	<!-- Admin group protection: only the managed admin, root and these may stay admin -->
	<key>ApprovedAdmins</key>
	<array>
		<string>group:helpdesk</string>  <!-- short names, or group:<name> -->
	</array>
	<key>AdminGroupPolicy</key>
	<string>auto</string>             <!-- auto, report or enforce -->

	<!-- Device mode: the MDM gets a reveal code; the password is revealed on the Mac -->
	<key>RetrievalMode</key>
	<string>escrow</string>           <!-- escrow or device -->
	<key>RevealGracePeriod</key>
	<integer>4</integer>              <!-- hours the password works after a reveal, 0-24 -->
	<key>RevealAction</key>
	<string>rotateAndLogout</string>  <!-- rotateAndLogout or rotate -->
	<key>ADRevealCode</key>
	<false/>                          <!-- Method AD in device mode: write the code to AD -->
</dict>
</plist>
