#!/bin/sh
: <<'HEADER'
===============================================================================
 macOSLAPS | Packaging | daemon-scripts/preinstall
===============================================================================
 Version:   4.0.0
 Author:    Richard Purves, Joshua D. Miller, Claude
 Created:   2026-11-10
 Updated:   2026-11-12

 Purpose:
     LaunchDaemon package preinstall: unloads and removes the existing
     LaunchDaemon, the current one and the one from 3.x / 4.0.0 (845), so
     the new one can be installed.

 Credits:
     Original by Richard Purves (github.com/franton).
===============================================================================
 CHANGELOG
===============================================================================
 Version   Date         Author    Description
 -------   ----------   -------   --------------------------------------------
 4.0.0     2026-11-12   joshua    Removes the old edu.psu.macoslaps-check and
                        claude    the new check and service daemons and the
                                  menu bar agent before installing.
===============================================================================
HEADER
[ "$3" = "/" ] || [ -z "$3" ] || exit 0
removed=0
for label in com.joshua-d-miller.macoslaps-check com.joshua-d-miller.macoslaps-service edu.psu.macoslaps-check; do
    plist="/Library/LaunchDaemons/$label.plist"
    /bin/launchctl bootout "system/$label" 2>/dev/null && removed=1
    if [ -f "$plist" ]; then
        /bin/rm -f "$plist"
        removed=1
    fi
done
# The menu bar agent in the logged-in user's session.
console_uid=$(/usr/bin/stat -f %u /dev/console 2>/dev/null)
if [ -n "$console_uid" ] && [ "$console_uid" != 0 ]; then
    /bin/launchctl bootout "gui/$console_uid/com.joshua-d-miller.macoslaps.agent" 2>/dev/null
fi
/bin/rm -f /Library/LaunchAgents/com.joshua-d-miller.macoslaps.agent.plist
# Let launchd settle before the new plist is bootstrapped.
[ "$removed" = 1 ] && sleep 3
exit 0
