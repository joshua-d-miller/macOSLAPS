#!/bin/sh
# macOSLAPS LaunchDaemon postinstall: forget the receipt from 3.x / 4.0.0 (845) and
# load the LaunchDaemon. RunAtLoad starts a run right away, so a new installation
# rotates without waiting for the interval. (Original by Richard Purves, github.com/franton.)
LAPS_DAEMON="/Library/LaunchDaemons/com.joshua-d-miller.macoslaps-check.plist"
[ "$3" = "/" ] || [ -z "$3" ] || exit 0

/usr/sbin/pkgutil --forget edu.psu.macOSLAPS-check >/dev/null 2>&1
/bin/chmod 644 "$LAPS_DAEMON"
/usr/sbin/chown root:wheel "$LAPS_DAEMON"
/bin/launchctl bootout system/com.joshua-d-miller.macoslaps-check 2>/dev/null
/bin/launchctl bootstrap system "$LAPS_DAEMON"
exit 0
